// Use Firestore rules version 2 for this database.
rules_version = '2';

service cloud.firestore {

    match /databases/{database}/documents {

        // Firebase fills in request.auth after sign-in. Signed-out requests have no user ID.
        function signedIn() {
            return request.auth != null;
        }

        // Check the saved event for reads and deletes.
        function ownsEvent(eventId) {
            return signedIn()
                && get(/databases/$(database)/documents/events/$(eventId))
                    .data.createdBy == request.auth.uid;
        }

        // When an event and its reminder are saved together, check who owns the event after that write.
        function ownsEventAfterWrite(eventId) {
            return signedIn()
                && getAfter(/databases/$(database)/documents/events/$(eventId))
                    .data.createdBy == request.auth.uid;
        }

        // Trust the email from the signed-in account, not an email typed into the app.
        function verifiedEmail() {
            return signedIn()
                && request.auth.token.get('email_verified', false) == true
                && request.auth.token.get('email', null) is string;
        }

        // Look up the existing calendar and compare its owner to the signed-in user.
        function ownsCalendar(calendarId) {
            return signedIn()
                && get(/databases/$(database)/documents/calendars/$(calendarId))
                    .data.ownerId == request.auth.uid;
        }

        // A share belongs to one calendar and one verified email.
        function canViewCalendar(calendarId, ownerId) {
            return verifiedEmail() && calendarId is string
                && calendarId != 'personal'
                && get(/databases/$(database)/documents/calendarShares/$(calendarId + ':' + request.auth.token.email.lower()))
                    .data.ownerId == ownerId;
        }

        // The shared event must belong to the calendar owner, not just have a matching calendar ID.
        function canReadSharedEvent(event) {
            return canViewCalendar(event.get('calendarId', null), event.createdBy)
                && get(/databases/$(database)/documents/calendars/$(event.calendarId))
                    .data.ownerId == event.createdBy;
        }

        // A user can create or move events into their own calendars only.
        function validEventCalendar(event) {
            let calendarId = event.get('calendarId', null);
            return calendarId == null || calendarId == 'personal'
                || (calendarId is string && ownsCalendar(calendarId));
        }

        // Only the owner can grant access to this calendar.
        function validShare(shareId) {
            let share = request.resource.data;
            return share.keys().hasOnly(['calendarId', 'ownerId', 'viewerEmail'])
                && share.calendarId is string
                && share.calendarId != 'personal'
                && share.calendarId.matches('[^:/]+')
                && share.viewerEmail is string
                && share.viewerEmail.size() <= 254
                && share.viewerEmail.matches('[^@:/ ]+@[^@:/ ]+[.][^@:/ ]+')
                && share.viewerEmail == share.viewerEmail.lower()
                && shareId == share.calendarId + ':' + share.viewerEmail
                && share.ownerId == request.auth.uid
                && ownsCalendar(share.calendarId);
        }

        // A signed-in user can only read or write their own profile.
        match /users/{userId} {

            allow create: if signedIn()
                && request.auth.uid == userId;

            allow read, update, delete: if signedIn()
                && request.auth.uid == userId;
        }

        // The creator controls changes to the event. Calendar viewers get read access only.
        match /events/{eventId} {

            // A new event must name the current user as its creator and use one of their own calendars.
            allow create: if signedIn()
                && request.resource.data.createdBy == request.auth.uid
                && validEventCalendar(request.resource.data);

            // Viewers can read events only from the calendar shared with them.
            allow read: if (signedIn() && resource.data.createdBy == request.auth.uid)
                || canReadSharedEvent(resource.data);

            // Compare the saved and proposed creator IDs so ownership cannot change.
            // If the event moves, check that its destination is also allowed.
            allow update: if signedIn()
                && resource.data.createdBy == request.auth.uid
                && request.resource.data.createdBy == request.auth.uid
                && (request.resource.data.get('calendarId', null) == resource.data.get('calendarId', null)
                    || validEventCalendar(request.resource.data));

            allow delete: if signedIn()
                && resource.data.createdBy == request.auth.uid;
        }

        // The owner lists and manages their own calendars. Viewers open one calendar they were granted.
        match /calendars/{calendarId} {

            allow create: if signedIn()
                && request.resource.data.ownerId == request.auth.uid;

            allow list, delete: if signedIn()
                && resource.data.ownerId == request.auth.uid;

            // Viewers can open a specific shared calendar, but cannot list all of its owner’s calendars.
            allow get: if (signedIn() && resource.data.ownerId == request.auth.uid)
                || canViewCalendar(calendarId, resource.data.ownerId);

            // Require the same owner before and after the update so edits cannot transfer ownership.
            allow update: if signedIn()
                && resource.data.ownerId == request.auth.uid
                && request.resource.data.ownerId == request.auth.uid;
        }

        match /calendarShares/{shareId} {
            // Each viewer can list their own shares, not the other viewers.
            allow read: if (signedIn() && resource.data.ownerId == request.auth.uid)
                || (verifiedEmail() && resource.data.viewerEmail == request.auth.token.email.lower());

            // The calendar owner grants access. An update can only resave the same grant.
            allow create: if signedIn() && validShare(shareId);
            allow update: if signedIn() && validShare(shareId)
                && request.resource.data == resource.data;
            // Revoking access deletes the grant. Later reads must pass the share check again.
            allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
        }

        // Reminders are private to the user who set them, even when the event is shared.
        match /reminders/{reminderId} {

            // A reminder must be for your own account and attached to an event you own.
            allow create: if signedIn()
                && request.resource.data.userId == request.auth.uid
                && ownsEventAfterWrite(request.resource.data.eventId);

            allow read, delete: if signedIn()
                && resource.data.userId == request.auth.uid;

            // Dismissing a reminder can change its status, but not its user or linked event.
            allow update: if signedIn()
                && resource.data.userId == request.auth.uid
                && request.resource.data.userId == request.auth.uid
                && request.resource.data.eventId == resource.data.eventId;
        }

        // A repeat record stores the schedule for one event. The event owner manages it.
        match /repetitions/{repetitionId} {

            // The event and its repeat record can be created in the same save, so check the event after the write.
            allow create: if ownsEventAfterWrite(
                request.resource.data.eventId
            );

            // Viewers only get the repeat settings for the event they can read.
            allow get: if canReadSharedEvent(
                    get(/databases/$(database)/documents/events/$(resource.data.eventId)).data
                ) && get(/databases/$(database)/documents/events/$(resource.data.eventId))
                    .data.get('repetitionId', null) == repetitionId;

            allow read, delete: if ownsEvent(

                resource.data.eventId
            );

            // Repeat settings can change, but the repeat record must stay linked to the same event.
            allow update: if ownsEvent(resource.data.eventId)
                && request.resource.data.eventId == resource.data.eventId;
        }

        // Deny anything the rules do not explicitly allow.
        match /{document=**} {

            allow read, write: if false;
        }
    }
}
