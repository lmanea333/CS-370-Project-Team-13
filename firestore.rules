rules_version = '2';

service cloud.firestore {
    match /databases/{database}/documents {

        // Checks whether the user signed in with Firebase
        function signedIn() {
            return request.auth != null;
        }

        function ownsEvent(eventId) {
            return signedIn()
                && get(
                    /databases/$(database)/documents/events/$(eventId)
                ).data.createdBy == request.auth.uid;
        }

        function ownsEventAfterWrite(eventId) {
            return signedIn()
                && getAfter(
                    /databases/$(database)/documents/events/$(eventId)
                ).data.createdBy == request.auth.uid;
        }

        // Each user can only access their own profile
        match /users/{userId} {
            allow create: if signedIn()
                && request.auth.uid == userId;

            allow read, update, delete: if signedIn()
                && request.auth.uid == userId;
        }

        // Users can create and access their own events
        match /events/{eventId} {
            allow create: if signedIn()
                && request.resource.data.createdBy
                    == request.auth.uid;

            allow read: if signedIn()
                && resource.data.createdBy
                    == request.auth.uid;

            allow update: if signedIn()
                && resource.data.createdBy
                    == request.auth.uid
                && request.resource.data.createdBy
                    == request.auth.uid;

            allow delete: if signedIn()
                && resource.data.createdBy
                    == request.auth.uid;
        }

        // Calendar documents are private until shared-calendar support is added.
        match /calendars/{calendarId} {
            allow create: if signedIn()
                && request.resource.data.ownerId == request.auth.uid;

            allow read, delete: if signedIn()
                && resource.data.ownerId == request.auth.uid;

            allow update: if signedIn()
                && resource.data.ownerId == request.auth.uid
                && request.resource.data.ownerId == request.auth.uid;
        }

        // Reminder access is limited to the user who owns the reminder.
        match /reminders/{reminderId} {
            allow create: if signedIn()
                && request.resource.data.userId == request.auth.uid
                && ownsEventAfterWrite(request.resource.data.eventId);

            allow read, delete: if signedIn()
                && resource.data.userId == request.auth.uid;

            allow update: if signedIn()
                && resource.data.userId == request.auth.uid
                && request.resource.data.userId == request.auth.uid
                && request.resource.data.eventId == resource.data.eventId;
        }

        // A repetition can only be accessed through an event the user owns.
        match /repetitions/{repetitionId} {
            allow create: if ownsEventAfterWrite(
                request.resource.data.eventId
            );

            allow read, delete: if ownsEvent(
                resource.data.eventId
            );

            allow update: if ownsEvent(resource.data.eventId)
                && request.resource.data.eventId
                    == resource.data.eventId;
        }

        // Block anything that was not explicitly allowed
        match /{document=**} {
            allow read, write: if false;
        }
    }
}
