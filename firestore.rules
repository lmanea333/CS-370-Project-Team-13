rules_version = '2';

service cloud.firestore {
    match /databases/{database}/documents {

        //check that the user is logged in
        function signedIn() {
            return request.auth != null;
        }

        //check whether the current user owns an event
        function ownsEvent(eventId) {
            return signedIn()
                && get(/databases/$(database)/documents/events/$(eventId))
                    .data.createdBy == request.auth.uid;
        }

        //used when checking an event after a write
        function ownsEventAfterWrite(eventId) {
            return signedIn()
                && getAfter(/databases/$(database)/documents/events/$(eventId))
                    .data.createdBy == request.auth.uid;
        }

        //users should only be able to access their own account
        match /users/{userId} {
            allow create: if signedIn()
                && request.auth.uid == userId;

            allow read, update, delete: if signedIn()
                && request.auth.uid == userId;
        }

        //event permissions
        match /events/{eventId} {
            allow create: if signedIn()
                && request.resource.data.createdBy == request.auth.uid;

            allow read: if signedIn()
                && resource.data.createdBy == request.auth.uid;

            allow update: if signedIn()
                && resource.data.createdBy == request.auth.uid
                && request.resource.data.createdBy == request.auth.uid;

            allow delete: if signedIn()
                && resource.data.createdBy == request.auth.uid;
        }

        //for now, calendars can only be accessed by their owner
        match /calendars/{calendarId} {
            allow create: if signedIn()
                && request.resource.data.ownerId == request.auth.uid;

            allow read, delete: if signedIn()
                && resource.data.ownerId == request.auth.uid;

            allow update: if signedIn()
                && resource.data.ownerId == request.auth.uid
                && request.resource.data.ownerId == request.auth.uid;
        }

        //users can only access their own reminders
        match /reminders/{reminderId} {
            allow create: if signedIn()
                && request.resource.data.userId == request.auth.uid
                && ownsEventAfterWrite(request.resource.data.eventId);

            allow read, delete: if signedIn()
                && resource.data.userId == request.auth.uid;

            allow update: if signedIn()
                && resource.data.userId == request.auth.uid
                && request.resource.data.userId == request.auth.uid
                && request.resource.data.eventId == resource.data.eventId;
        }

        //repetitions belong to an event, so the user must own that event
        match /repetitions/{repetitionId} {
            allow create: if ownsEventAfterWrite(
                request.resource.data.eventId
            );

            allow read, delete: if ownsEvent(
                resource.data.eventId
            );

            allow update: if ownsEvent(resource.data.eventId)
                && request.resource.data.eventId == resource.data.eventId;
        }

        //deny access to anything that does not have a rule above
        match /{document=**} {
            allow read, write: if false;
        }
    }
}
